# EcoLens AI configuration (all optional — sensible defaults are built in).
# Copy to `.env` and adjust if needed. Never commit a real `.env`.

# Model registry key: mobilenet_v3_large | mobilenet_v3_small | efficientnet_b0
ECOLENS_MODEL=mobilenet_v3_large

# Inference device: auto | cpu | cuda  (auto uses GPU/MPS when available)
ECOLENS_DEVICE=auto

# Operational confidence threshold (0-1). Below this, no material-specific
# guidance is shown.
ECOLENS_CONFIDENCE_THRESHOLD=0.35

# Normalised entropy threshold above which a prediction is treated as uncertain.
ECOLENS_ENTROPY_THRESHOLD=0.65

# Number of top predictions to return.
ECOLENS_TOP_K=5

# Allow downloading pretrained weights from download.pytorch.org on first run.
# Set to 0 for a fully offline deployment with pre-cached weights.
ECOLENS_ALLOW_DOWNLOAD=1

# Upload limits
ECOLENS_MAX_UPLOAD_MB=12
ECOLENS_MIN_DIM=32
ECOLENS_MAX_DIM=12000

# Storage locations (defaults under the repo).
# ECOLENS_STORAGE_DIR=./storage
# ECOLENS_DB_PATH=./storage/ecolens.db
# ECOLENS_DATA_DIR=./data
# ECOLENS_KNOWLEDGE_PATH=./data/material_knowledge.json

# History pagination
ECOLENS_PAGE_SIZE=8
